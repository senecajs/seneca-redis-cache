{
  "name": "@seneca/redis-cache",
  "version": "2.1.0",
  "description": "Redis caching plugin for seneca",
  "main": "redis.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "doc": "seneca-doc",
    "prettier": "prettier --write --no-semi --single-quote *.js test/*.js",
    "clean": "rm -rf node_modules package-lock.json yarn.lock",
    "reset": "npm run clean && npm i && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm install --registry http://registry.npmjs.org && npm run repo-publish-quick",
    "repo-publish-quick": "npm run prettier && npm test && npm run repo-tag && npm publish --registry http://registry.npmjs.org --access public",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/senecajs/seneca-redis-cache.git"
  },
  "keywords": [
    "seneca",
    "cache",
    "redis",
    "plugin"
  ],
  "contributors": [
    "Seamus D'Arcy",
    "Richard Rodger (http://richardrodger.com/)",
    "Shane Lacey (https://github.com/shanel262)",
    "Nicolas Herment (https://github.com/nherment)",
    "Erik Straub (https://github.com/brkattk)"
  ],
  "license": "MIT",
  "files": [
    "LICENSE.txt",
    "README.md",
    "redis.js"
  ],
  "dependencies": {
    "redis": "^3.0.2"
  },
  "devDependencies": {
    "@seneca/cache-test": "^2.0.0",
    "@seneca/doc": "^4.0.0",
    "prettier": "^2.0.5",
    "seneca": "^4.0.0-rc5",
    "seneca-plugin-validator": "^0.6.1",
    "uuid": "^8.2.0"
  },
  "peerDependencies": {
    "seneca": ">=3 || >=4.0.0-rc5"
  }
}
